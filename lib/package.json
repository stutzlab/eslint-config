{
    "name": "@stutzlab/eslint-config",
    "version": "0.0.1",
    "type": "module",
    "description": "ESLint rules in 'Golang style'",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist/index.js",
        "dist/index.cjs"
    ],
    "peerDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^10.0.0",
        "eslint-import-resolver-typescript": "^4.0.0",
        "eslint-plugin-functional": "^10.0.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.0.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-promise": "^7.0.0",
        "eslint-plugin-unicorn": "^73.0.0",
        "prettier": "^3.9.6"
    },
    "devDependencies": {
        "esbuild": "^0.28.2"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/stutzlab/eslint-config"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "packageManager": "pnpm@10.0.0",
    "pnpm": {
        "overrides": {
            "//": "deepmerge-ts <8.0.0 has a high severity stack exhaustion vulnerability (GHSA-ggr8-5vv4-36mx); force patched version until eslint-plugin-functional upgrades its dependency",
            "deepmerge-ts": ">=8.0.0"
        }
    }
}
